 primType        = 4       ; D3DPT_TRIANGLELIST
 debug           = 0       ; 1 = the bend as a colour (Debug View 30)
 
+; Dense grass (EqAzeroth): each of the client's grass batches is drawn again, a copy at a time, by the GPU with the copy
+; shader (grass.cpp). The copies move the batch by a smooth offset, thin themselves out in patches, change colour and tip
+; height a little, and sink into the ground with distance. The client's own grass is always drawn first and untouched.
+; density 1 = off and nothing extra is drawn. Cost: one more draw per copy per batch within densityDist, on the one CPU
+; thread: read "the grass's CPU a frame" in /atmos framelog before and after. F11 reloads.
+density       = 1.0     ; 1..8: draws of each batch in all, a smooth number (2.5 = the original, one copy and half a copy)
+densityDist  = 45      ; yards: where the first copy has faded out; the next copies end sooner (35 % less each step)
+densityFade  = 0.35    ; 0.05..1: the share of that distance over which a copy fades out
+spread       = 1.2     ; yards: how far a copy lies from the original blades
+wobble       = 0.45    ; yards: smooth change of that offset over the ground, so the copies do not repeat
+patch        = 1.5     ; yards: the size of the patches in which a partial copy (the .5 of 2.5) grows
+heightVar    = 0.25    ; yards: a copy's tip is higher or lower by up to this
+tintVar      = 0.12    ; 0..0.5: a copy's colour is warmer or greener by up to this
+alphaRef     = -1      ; -1: the client's alpha test. 0..255: alpha test (>=) for the copies only, so that the see-through
+                       ; parts of a card do not hide the copies behind it (try 96 if copies show square holes)
+chunkSign    = -1      ; which way a chunk lies from its corner, for the slope under a copy: -1 = to lower x and y
+copyDebug    = 0       ; 1 = copies in flat red to yellow by number: shows what is drawn
+
 ; The time of day, on your screen only (comfytime until 2026-10-07). Ctrl+PageUp / Ctrl+PageDown move the time
 ; by step hours, later / earlier; hold to keep moving. Ctrl+End switches between dayHour and nightHour. The Time
 ; section of /atmos options sets enabled and localTime: Server time, Computer time or Fixed hour. With a fixed hour,
